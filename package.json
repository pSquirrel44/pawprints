{
  "name": "pawprint-network",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "ts-node-esm server/index.ts",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "build": "node scripts/preflight.cjs && vite build && tsc -p tsconfig.server.json && esbuild server/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/server.cjs --external:pg --external:@clerk/express --external:cors --external:express",
    "start": "node dist/server.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.2.0",
    "@clerk/express": "^1.2.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.11.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.0"
  }
}
